+    @staticmethod
+    def _call_signature(name: str, args: Any) -> str:
+        """Stable identity for "this exact call".
+
+        Sorted keys so reordering the arguments cannot disguise a repeat, and
+        `default=str` so an unserialisable argument degrades instead of raising: a
+        progress check that can crash the graph is worse than no progress check.
+        """
+        try:
+            blob = json.dumps(
+                args or {}, sort_keys=True, default=str, separators=(",", ":")
+            )
+        except Exception:  # noqa: BLE001
+            blob = repr(args)
+        return f"{name}:{blob}"
+
+    def _executed_signatures(self, input: Any) -> list[str]:
+        """Signatures of the tool calls in this transcript that actually RAN.
+
+        Derived from the messages rather than counted on `self`, because a `ToolNode`
+        instance is shared by every request the process serves; a counter stored on it
+        would leak one request's loop into another's. A call whose `ToolMessage` is an
+        error did not run, and must not be counted as a repeat of itself.
+        """
+        if isinstance(input, list):
+            messages = input
+        elif isinstance(input, dict):
+            messages = input.get(self._messages_key) or []
+        else:
+            messages = getattr(input, self._messages_key, None) or []
+        answered: set[str] = set()
+        failed: set[str] = set()
+        for message in messages:
+            if getattr(message, "type", None) == "tool":
+                answered.add(getattr(message, "tool_call_id", ""))
+                if getattr(message, "status", None) == "error":
+                    failed.add(getattr(message, "tool_call_id", ""))
+        signatures: list[str] = []
+        for message in messages:
+            for call in getattr(message, "tool_calls", None) or []:
+                call_id = (
+                    call.get("id") if isinstance(call, dict) else getattr(call, "id", None)
+                )
+                if call_id in answered and call_id not in failed:
+                    name = (
+                        call.get("name")
+                        if isinstance(call, dict)
+                        else getattr(call, "name", "")
+                    )
+                    args = (
+                        call.get("args")
+                        if isinstance(call, dict)
+                        else getattr(call, "args", None)
+                    ) or {}
+                    signatures.append(self._call_signature(name, args))
+        return signatures
+
+    def _no_progress_refusals(
+        self, input: Any, tool_calls: list[ToolCall]
+    ) -> list[ToolMessage] | None:
+        """`None` when the turn may proceed, otherwise a refusal for every pending call.
+
+        All-or-nothing per turn: half-running a batch would leave the repeat history
+        describing work that never happened.
+        """
+        if self._no_progress_limit is None or not tool_calls:
+            return None
+        history = self._executed_signatures(input)
+        offenders = [
+            call
+            for call in tool_calls
+            if history.count(self._call_signature(call["name"], call.get("args")))
+            >= self._no_progress_limit - 1
+        ]
+        if not offenders:
+            return None
+        offending = ", ".join(sorted({call["name"] for call in offenders}))
+        return [
+            ToolMessage(
+                content=(
+                    f"Refused: this request has already run {offending} with these exact "
+                    f"arguments {self._no_progress_limit - 1} time(s) and is not making "
+                    f"progress (no_progress_limit={self._no_progress_limit}). The tool "
+                    f"was NOT called. Try a different approach, or answer with what you "
+                    f"already have."
+                ),
+                name=call["name"],
+                tool_call_id=call["id"],
+                status="error",
+            )
+            for call in tool_calls
+        ]
+
